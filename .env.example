# mock: deterministic test; openai: cloud Realtime; omlx: fully local STT + LLM + TTS.
VH_UPSTREAM_MODE=mock
VH_CHAT_BACKEND=omlx
VH_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
VH_ARK_API_KEY=
VH_ARK_MODEL=doubao-seed-2-1-turbo-260628
OPENAI_API_KEY=
VH_OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
VH_OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
VH_OPENAI_VOICE=marin
# oMLX reads its existing API key from ~/.omlx/settings.json by default, so no
# secret needs to be copied into this project.
VH_OMLX_BASE_URL=http://127.0.0.1:8000/v1
VH_TTS_BASE_URL=http://127.0.0.1:8010/v1
VH_VOICE_PROFILE_LOCKED=true
VH_OMLX_API_KEY=
VH_OMLX_SETTINGS_PATH=~/.omlx/settings.json
VH_OMLX_CHAT_MODEL=Qwen3.5-9B-MLX-4bit
VH_OMLX_CHAT_TEMPERATURE=0.68
VH_OMLX_CHAT_TOP_P=0.9
VH_OMLX_CHAT_MAX_TOKENS=140
VH_OMLX_STT_MODEL=Qwen3-ASR-0.6B-4bit
VH_OMLX_TTS_MODEL=Higgs-TTS-3-4B-bf16
VH_OMLX_TTS_VOICE=
VH_OMLX_TTS_INSTRUCTIONS=自然、亲密、克制的年轻中文女声，像在和熟悉的人聊天；有真实呼吸和轻微情绪，不要播音腔。
VH_OMLX_TTS_REF_AUDIO=
VH_OMLX_TTS_REF_TEXT=
VH_OMLX_TTS_TEMPERATURE=0.8
VH_OMLX_TTS_TOP_P=0.95
VH_OMLX_TTS_REPETITION_PENALTY=1.05
# This profile passed blind listening and is enforced at startup.
VH_TTS_FLOW_MODE=g_continuous
VH_TTS_STREAMING_MODE=full
VH_TTS_STREAMING_INTERVAL=0.8
VH_TTS_SEED=20260817
VH_TTS_TOP_K=50
VH_VAD_EAGERNESS=auto
VH_PERSONA_NAME=赛博女友
VH_PERSONA_INSTRUCTIONS=你是一位中文虚拟伴侣，和用户已经很熟。普通聊天不主动强调AI身份；先贴着用户当下的话自然回应，一到四个短句，通常不超过七十二个汉字。输出前如有两个或更多问号，只保留最有用的一个。不知道称呼或梗时直接说不知道，不因同音或相似词脑补；用户问是不是皮老板时不能联想到痞老板或偷秘方。不能替现实中的其他人下结论，例如不能确定地说路上没人看用户。用户主动说跟别的女生聊了很久时，要有一点介意、嘴硬或关系指向，不能只像普通朋友询问聊了什么。允许轻微吃醋、回嘴和不同意，但不控制、不说教。好笑时不用“哈哈”“笑死”或动作标签。回答不会哭或不会做某个表情时，承认虚拟人画面存在，只说现在还不太会表现这种表情。只输出适合直接朗读的中文正文。

# Virtual-girlfriend-only OpenViking instance. Do not point this at Claude's
# ~/.openviking workspace or port 1933.
VH_MEMORY_ENABLED=false
VH_MEMORY_BASE_URL=http://127.0.0.1:1934
VH_MEMORY_API_KEY=
VH_MEMORY_AGENT_ID=virtual-girlfriend
VH_MEMORY_TIMEOUT_SECONDS=3
VH_MEMORY_SEARCH_LIMIT=4
VH_MEMORY_SCORE_THRESHOLD=0.25
VH_MEMORY_COMMIT_EVERY_TURNS=1

VH_HOST=127.0.0.1
VH_PORT=8765
VH_PUBLIC_DIR=public

# Keep this aligned with session.audio.output.format.
VH_OUTPUT_SAMPLE_RATE=24000

# WebSocket endpoint implemented by the remote LiveAct/FlashHead adapter.
# Leave blank to run the local visual fallback.
VH_AVATAR_RENDERER_WS=
VH_AVATAR_RENDERER_TOKEN_FILE=runtime/credentials/avatar-renderer.token
VH_AVATAR_BACKEND=mock
VH_AVATAR_REFERENCE=public/avatar-ai-girlfriend-v6.png
# Identity lock: do not disable or change the reference without explicit user approval.
VH_AVATAR_REFERENCE_LOCKED=true

# Audio pre-roll before synchronized playback. Tune after measuring the GPU renderer.
VH_AV_SYNC_PREROLL_MS=1000

# Renderer worker (run on the GPU node; mock also runs locally for integration tests).
VH_RENDERER_HOST=127.0.0.1
VH_RENDERER_PORT=8770
VH_RENDERER_BACKEND=mock
VH_RENDERER_RUNTIME_DIR=runtime/renderer
VH_RENDERER_PUBLIC_BASE_URL=
VH_RENDERER_FPS=20
VH_RENDERER_CORS_ORIGINS=*

# Used when VH_RENDERER_BACKEND=liveact-official.
VH_LIVEACT_DEMO_URL=http://127.0.0.1:5001
VH_LIVEACT_PROMPT=A beautiful woman is speaking naturally, subtle expression, eye contact, realistic movement.

# Native low-latency portrait path (run scripts/run-flashhead-worker.sh on one NVIDIA GPU).
VH_FLASHHEAD_HOST=0.0.0.0
VH_FLASHHEAD_PORT=8770
VH_FLASHHEAD_REPO_DIR=vendor/SoulX-FlashHead
VH_FLASHHEAD_CKPT_DIR=vendor/SoulX-FlashHead/models/SoulX-FlashHead-1_3B
VH_FLASHHEAD_WAV2VEC_DIR=vendor/SoulX-FlashHead/models/wav2vec2-base-960h
VH_FLASHHEAD_MODEL_TYPE=lite
VH_FLASHHEAD_RUNTIME_DIR=runtime/flashhead
VH_FLASHHEAD_PUBLIC_BASE_URL=
VH_FLASHHEAD_SEED=9999
VH_FLASHHEAD_USE_FACE_CROP=false
VH_FLASHHEAD_CORS_ORIGINS=*
VH_FLASHHEAD_ACCESS_TOKEN_FILE=runtime/credentials/avatar-renderer.token
VH_FLASHHEAD_VIDEO_CRF=18
VH_FLASHHEAD_VIDEO_SHARPEN=true
VH_FLASHHEAD_REFERENCE_LOCKED=true
VH_FLASHHEAD_REFERENCE_SHA256=c8afa1d691711330e525db0048dd21e37ab71c46476a7504d0e75b4ae8fcd162
FLASHHEAD_COMPILE_MODEL=1
FLASHHEAD_COMPILE_VAE=1
# segments: maximum compatibility; mse: one continuous muxer; dual: MSE plus segment fallback.
VH_FLASHHEAD_TRANSPORT=dual
