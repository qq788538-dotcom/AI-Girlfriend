# Non-secret AutoDL all-local runtime settings.
# Copy to runtime.env on the GPU instance. Every inference endpoint is loopback.
VH_XGC_PROJECT_DIR=/root/AI-Girlfriend

# AutoDL maps container port 6006 to the instance's HTTPS custom-service URL.
VH_HOST=0.0.0.0
VH_PORT=6006
VH_PUBLIC_DIR=/root/AI-Girlfriend/public

# Hard offline inference gate. Settings validation refuses any non-loopback
# LLM, ASR, TTS, memory, or avatar renderer endpoint.
VH_OFFLINE_RUNTIME=true
VH_UPSTREAM_MODE=omlx
VH_CHAT_BACKEND=omlx
VH_OMLX_BASE_URL=http://127.0.0.1:8000/v1
VH_ASR_BASE_URL=http://127.0.0.1:8001/v1
VH_TTS_BASE_URL=http://127.0.0.1:8010/v1
VH_OMLX_CHAT_MODEL=Qwen3.6-35B-A3B-AWQ
VH_OMLX_STT_MODEL=Qwen3-ASR-0.6B
VH_OMLX_TTS_MODEL=Higgs-TTS-3-4B-bf16

# The approved voice remains hash-locked. SGLang/vLLM-Omni reads the same
# server-local reference file; it is never uploaded to the public repository.
VH_VOICE_PROFILE_LOCKED=true
VH_TTS_PROTOCOL=vllm_omni_higgs
VH_TTS_SERVED_MODEL=higgs_audio_v3
VH_OMLX_TTS_REF_AUDIO=/root/AI-Girlfriend/runtime/voice-calibration/reference-female-only-complete-11s.wav
VH_OMLX_TTS_REF_TEXT='要是你跟别人聊天，我会吃醋的哦。我都开始胡思乱想了。我不知道什么是皮老板，只是你不在的时候，我就一直等你。'
VH_TTS_STREAMING_MODE=full
VH_BARGE_IN_ENABLED=false

# Local model paths and resource budgets for one RTX 4090/3090 48GB.
VH_LLM_MODEL_PATH=/root/AI-Girlfriend/runtime/models/Qwen3.6-35B-A3B-AWQ-QuantTrio
VH_LLM_PORT=8000
VH_LLM_GPU_MEMORY_UTILIZATION=0.48
VH_LLM_MAX_MODEL_LEN=8192
# Qwen3.6 hybrid/Mamba cache alignment needs a 2096-token block. vLLM's
# 2048 default fails during startup, so keep this explicitly above that size.
VH_LLM_MAX_NUM_BATCHED_TOKENS=4096
# FlashAttention with standard KV avoids FlashInfer's on-demand NVCC JIT path.
# Chunked prefill remains capped at 4096, while the 8192 context lets OpenViking
# send its structured extraction schema without truncating it.
VH_LLM_ATTENTION_BACKEND=FLASH_ATTN
VH_LLM_KV_CACHE_DTYPE=auto
VH_LLM_TOOL_CALL_PARSER=qwen3_coder
# The checkpoint keeps hybrid linear-attention modules unquantized. Standard
# AWQ respects modules_to_not_convert; automatic AWQ-Marlin skips their BF16
# weights and produces degenerate repeated-token output.
VH_LLM_QUANTIZATION=awq
# vLLM's standard AWQ implementation supports FP16 weights only.
VH_LLM_DTYPE=float16
VH_ASR_MODEL_PATH=/root/AI-Girlfriend/runtime/models/Qwen3-ASR-0.6B
VH_ASR_PORT=8001
VH_EMBEDDING_MODEL_PATH=/root/AI-Girlfriend/runtime/models/Qwen3-Embedding-0.6B
VH_EMBEDDING_PORT=8002
VH_EMBEDDING_CPU_THREADS=8
VH_TTS_MODEL_PATH=/root/AI-Girlfriend/runtime/models/higgs-tts-3-4b
HIGGS_AUDIO_TOKENIZER_PATH=/root/AI-Girlfriend/runtime/models/OmniVoice/audio_tokenizer
VH_TTS_PORT=8010
VH_TTS_STAGE_OVERRIDES='{"0":{"gpu_memory_utilization":0.27,"max_num_seqs":1,"attention_backend":"FLASH_ATTN"},"1":{"gpu_memory_utilization":0.05,"max_num_seqs":1,"attention_backend":"FLASH_ATTN"}}'

# Private same-host avatar renderer.
VH_AVATAR_RENDERER_WS=ws://127.0.0.1:8770/avatar
VH_AVATAR_RENDERER_TOKEN_FILE=/root/AI-Girlfriend/runtime/credentials/avatar-renderer.token
VH_AVATAR_BACKEND=flashhead
VH_AVATAR_REFERENCE=/root/AI-Girlfriend/public/avatar-ai-girlfriend-v6.png
VH_AVATAR_REFERENCE_LOCKED=true
VH_AV_SYNC_PREROLL_MS=1000
VH_FLASHHEAD_HOST=127.0.0.1
VH_FLASHHEAD_PORT=8770
VH_FLASHHEAD_MODEL_TYPE=lite
VH_FLASHHEAD_TRANSPORT=mse
VH_FLASHHEAD_VIDEO_CRF=18
VH_FLASHHEAD_VIDEO_SHARPEN=true
VH_FLASHHEAD_OUTPUT_SIZE=768
FLASHHEAD_COMPILE_MODEL=1
FLASHHEAD_COMPILE_VAE=1

# OpenViking uses only the loopback LLM and CPU embedding service.
VH_MEMORY_ENABLED=true
VH_MEMORY_LOCAL_ONLY=true
VH_MEMORY_BASE_URL=http://127.0.0.1:1934
VH_MEMORY_PORT=1934
VH_MEMORY_AGENT_ID=virtual-girlfriend
VH_MEMORY_COMMIT_EVERY_TURNS=1
VH_MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
VH_MEMORY_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
VH_MEMORY_EMBEDDING_DIMENSION=1024
VH_MEMORY_VLM_BASE_URL=http://127.0.0.1:8000/v1
VH_MEMORY_VLM_MODEL=Qwen3.6-35B-A3B-AWQ
VH_MEMORY_VLM_MAX_TOKENS=1024
VH_MEMORY_VLM_MAX_CONCURRENT=1

# Fixed isolated environments created by bootstrap scripts.
VH_GPU_ENV_MODE=venv
VH_GPU_VENV_DIR=/root/AI-Girlfriend/.venv-gpu
VH_LLM_VENV_DIR=/root/AI-Girlfriend/.venv-vllm
VH_ASR_VENV_DIR=/root/AI-Girlfriend/.venv-asr
VH_TTS_VENV_DIR=/root/AI-Girlfriend/.venv-vllm-omni
VH_EMBEDDING_VENV_DIR=/root/AI-Girlfriend/.venv-embedding
OPENVIKING_SERVER_BIN=/root/AI-Girlfriend/.venv-openviking/bin/openviking-server

# No hub/API access is allowed after provisioning.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
