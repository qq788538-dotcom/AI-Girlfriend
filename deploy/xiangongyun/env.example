# Non-secret Xiangongyun runtime settings.
# Copy this file to runtime.env on the GPU instance.
VH_XGC_PROJECT_DIR=/root/AI-Girlfriend

# Xiangongyun publishes container port 80 as the instance web URL.
VH_HOST=0.0.0.0
VH_PORT=80
VH_PUBLIC_DIR=/root/AI-Girlfriend/public

# oMLX remains on the Mac. Supply HTTPS endpoints that the Xiangongyun
# instance can reach; do not use 127.0.0.1 here.
VH_UPSTREAM_MODE=omlx
VH_CHAT_BACKEND=ark
VH_OMLX_BASE_URL=https://replace-with-private-omlx-endpoint.example/v1
VH_TTS_BASE_URL=https://replace-with-private-higgs-endpoint.example/v1
VH_OMLX_CHAT_MODEL=Qwen3.6-35B-A3B-4bit
VH_OMLX_STT_MODEL=Qwen3-ASR-0.6B-4bit
VH_OMLX_TTS_MODEL=Higgs-TTS-3-4B-bf16
VH_VOICE_PROFILE_LOCKED=true

# The renderer and memory database are private same-host services.
VH_AVATAR_RENDERER_WS=ws://127.0.0.1:8770/avatar
VH_AVATAR_RENDERER_TOKEN_FILE=/root/AI-Girlfriend/runtime/credentials/avatar-renderer.token
VH_AVATAR_BACKEND=flashhead
VH_AVATAR_REFERENCE=/root/AI-Girlfriend/public/avatar-ai-girlfriend-v6.png
VH_AVATAR_REFERENCE_LOCKED=true
VH_AV_SYNC_PREROLL_MS=1000

VH_FLASHHEAD_HOST=127.0.0.1
VH_FLASHHEAD_PORT=8770
VH_FLASHHEAD_MODEL_TYPE=lite
VH_FLASHHEAD_TRANSPORT=mse
VH_FLASHHEAD_VIDEO_CRF=18
VH_FLASHHEAD_VIDEO_SHARPEN=true
VH_FLASHHEAD_OUTPUT_SIZE=768
FLASHHEAD_COMPILE_MODEL=1
FLASHHEAD_COMPILE_VAE=1

VH_MEMORY_ENABLED=true
VH_MEMORY_BASE_URL=http://127.0.0.1:1934
VH_MEMORY_PORT=1934
VH_MEMORY_AGENT_ID=virtual-girlfriend
VH_MEMORY_COMMIT_EVERY_TURNS=1

# Fixed service environments created by bootstrap.sh.
VH_GPU_ENV_MODE=venv
VH_GPU_VENV_DIR=/root/AI-Girlfriend/.venv-gpu
OPENVIKING_SERVER_BIN=/root/AI-Girlfriend/.venv-openviking/bin/openviking-server
